# Public Base mainnet address that receives the x402 card fee (required).
PAY_TO_ADDRESS=0xYourTreasuryAddress
# Card fee in atomic USDC; must be <= the plugin's maxAmount (10000 = $0.01).
CARD_FEE_ATOMIC=10000
# Coinbase CDP facilitator credentials (required for Base mainnet settlement).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional: use a different x402 facilitator instead of CDP.
# FACILITATOR_URL=
# Optional but strongly recommended on Vercel: shared storage so every
# serverless instance sees the same cards and revocations (Upstash / Vercel KV).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
